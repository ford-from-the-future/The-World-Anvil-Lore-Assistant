{
  "name": "the-world-anvil-lore-assistant",
  "version": "0.1.0",
  "description": "Bare-bones CLI scaffold for the World Anvil Lore Assistant (WALA)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "serve": "node src/server/index.js",
    "dev": "node --watch src/index.js",
    "lint": "node scripts/lint.js",
    "backup": "node scripts/backup.js",
    "extract": "node scripts/extract.js",
    "widget:dev": "npm --prefix widget run dev",
    "widget:build": "npm --prefix widget run build"
  },
  "keywords": [
    "world-anvil",
    "lore",
    "assistant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  }
}

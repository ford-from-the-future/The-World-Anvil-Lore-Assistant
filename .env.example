# Server-side secrets (never ship to the widget)
WALA_APPLICATION_KEY=
WALA_AUTH_TOKEN=
WALA_WORLD_ID=
WALA_WORLD_URL=
WALA_RSS_URL=
GOOGLE_GEMINI_API_KEY=

# Widget bridge
# Base path for the widget API mount (defaults to /api/wala)
WALA_WIDGET_API_BASE=/api/wala
# Allowed origin for cross-site embeds. Leave empty to skip CORS headers.
WALA_WIDGET_ALLOWED_ORIGIN=
